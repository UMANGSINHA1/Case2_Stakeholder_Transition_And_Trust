      "question": "Which insurance provider has the best clinical outcomes?",
      "expected_file": null,
      "must_contain": [],
      "answerable": false
    },
    {
      "id": "U04",
      "question": "What is the FDA-approved indication for this medication?",
      "expected_file": null,
      "must_contain": [],
      "answerable": false
    }
  ]
