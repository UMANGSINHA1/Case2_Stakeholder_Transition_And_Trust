OPENAI_API_KEY=
OPENAI_BASE_URL=
RAG_MODEL=gpt-4.1-mini
# Optional local/cached models. The assistant never downloads models implicitly.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Set to 1 to force lexical-only mode / disable model components.
RAG_DISABLE_EMBEDDINGS=0
RAG_DISABLE_RERANKER=0
